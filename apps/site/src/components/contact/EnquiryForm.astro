---
import { SITE, emailLink, safeLink } from '../../config/site';

const email = emailLink(SITE.email);
const endpoint = safeLink(SITE.formEndpoint);
---

<section class="enquiry" id="contact" aria-labelledby="enquiry-title">
  <div class="enquiry__intro">
    <h2 id="enquiry-title">Tell me what you’re working through.</h2>
    <p>
      I’ll respond within two business days and, when Azul looks useful, we’ll arrange a free 20–30
      minute call.
    </p>
    <div class="enquiry__expectation">
      <span>What happens next</span>
      <p>Useful reply → fit check → manually arranged call</p>
    </div>
    {
      email && (
        <p class="enquiry__email">
          Prefer email? <a href={email}>{SITE.email}</a>
        </p>
      )
    }
  </div>

  <form
    class="enquiry-form"
    method="post"
    action={endpoint}
    data-enquiry-form
    data-endpoint={endpoint ?? ''}
    data-email={SITE.email}
  >
    <input type="hidden" name="guide_summary" value="" data-guide-summary />
    <label class="honeypot" aria-hidden="true">
      Leave this field empty
      <input type="text" name="company_site_confirm" tabindex="-1" autocomplete="off" />
    </label>

    <div class="form-grid">
      <label>
        <span>Name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        <span>Business name</span>
        <input name="business" autocomplete="organization" required />
      </label>
      <label>
        <span>Website or social profile <small>Optional</small></span>
        <input type="url" name="current_presence" inputmode="url" placeholder="https://" />
      </label>
      <label class="select-field">
        <span>Business stage</span>
        <select name="business_stage" data-enquiry-stage required>
          <option value="">Choose one</option>
          <option value="starting">Starting</option>
          <option value="operating">Operating</option>
          <option value="growing">Growing</option>
        </select>
      </label>
      <label class="select-field">
        <span>Service interest</span>
        <select name="service_interest" data-service-interest required>
          <option value="">Choose one</option>
          <option value="Online Foundation">Online Foundation</option>
          <option value="Ongoing Visibility">Ongoing Visibility</option>
          <option value="Web development">Web development</option>
          <option value="Google Business Profile">Google Business Profile</option>
          <option value="Meta Business">Meta Business</option>
          <option value="Social Content">Social Content</option>
          <option value="Not sure yet">Not sure yet</option>
        </select>
      </label>
      <label class="select-field">
        <span>Primary goal</span>
        <select name="primary_goal" data-enquiry-goal required>
          <option value="">Choose one</option>
          <option value="Look credible">Look credible</option>
          <option value="Get discovered">Get discovered</option>
          <option value="Promote services">Promote services</option>
          <option value="Stay active">Stay active</option>
          <option value="Something else">Something else</option>
        </select>
      </label>
      <label class="select-field">
        <span>Preferred timeline</span>
        <select name="timeline" required>
          <option value="">Choose one</option>
          <option>As soon as practical</option>
          <option>Within 1–2 months</option>
          <option>Within 3–6 months</option>
          <option>I’m exploring for later</option>
        </select>
      </label>
      <label class="form-grid__wide select-field">
        <span>Budget comfort <small>Optional</small></span>
        <select name="budget">
          <option value="">Not sure yet — we can identify a realistic place to begin</option>
          <option>Under $1,000 — let’s grow on a lean budget</option>
          <option>$1,000–$2,500 — a focused site or targeted improvement</option>
          <option>$2,500–$5,000 — a broader foundation across multiple needs</option>
          <option>Over $5,000 — a larger, custom, or ongoing project</option>
        </select>
      </label>
      <label class="form-grid__wide content-needs" data-content-needs hidden>
        <span>What kind of content would help?</span>
        <input
          name="content_needs"
          placeholder="For example: short video, scripts, static graphics, or help deciding"
        />
      </label>
      <label class="form-grid__wide">
        <span>What should I understand?</span>
        <textarea
          name="message"
          rows="6"
          required
          placeholder="Tell me about your current pain points, ideas you want to avoid, and the problems you need solved."
        ></textarea>
      </label>
    </div>

    <label class="privacy-check">
      <input type="checkbox" name="privacy_acknowledged" required />
      <span
        >I understand that Azul will use these details only to respond and assess fit. <a
          href="/privacy">Read the privacy note.</a
        ></span
      >
    </label>

    <div class="enquiry-form__submit">
      <button class="signal-button" type="submit">
        <span>Send project context</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
      </button>
      <p role="status" aria-live="polite" data-form-status>
        No booking software. No automatic sales sequence.
      </p>
    </div>
  </form>
</section>

<script src="../../scripts/enquiry-form.ts"></script>
