---
interface Props {
  diagonal?: boolean;
  class?: string;
}
const { diagonal = false, class: className = '' } = Astro.props;
---

<svg
  class:list={['arrow-icon', className]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  {diagonal ? <path d="M5 19 19 5M5 5h14v14" /> : <path d="M3 12h17m-7-7 7 7-7 7" />}
</svg>
