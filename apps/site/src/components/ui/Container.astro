---
import type { ShellWidth } from '../../types/site';

interface Props {
  width?: ShellWidth;
  class?: string;
  id?: string;
}

const { width = 'standard', class: className = '', id } = Astro.props;

const widthClasses: Record<ShellWidth, string> = {
  full: 'w-full',
  standard: 'w-full max-w-[80rem] mx-auto px-4 sm:px-8 lg:px-12',
  reading: 'w-full max-w-[65ch] mx-auto px-4 sm:px-8',
  evidence: 'w-full max-w-[90rem] mx-auto px-4 sm:px-8',
};
---

<div id={id} class:list={[widthClasses[width], className]}>
  <slot />
</div>
