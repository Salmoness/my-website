---
interface Props {
  kicker?: string | undefined;
  title: string;
  subtitle?: string | undefined;
  id?: string | undefined;
  class?: string | undefined;
  level?: 1 | 2 | 3 | 4 | undefined;
}

const { kicker, title, subtitle, id, class: className = '', level = 2 } = Astro.props;

const HeadingTag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';
---

<div id={id} class:list={['mb-8', className]}>
  {
    kicker && (
      <div class="font-mono text-xs font-bold uppercase tracking-widest text-[var(--color-signal-action-hover)] mb-2">
        {kicker}
      </div>
    )
  }
  <HeadingTag
    class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-[var(--color-ink-primary)]"
  >
    {title}
  </HeadingTag>
  {
    subtitle && (
      <p class="mt-2 text-base sm:text-lg text-[var(--color-ink-muted)] max-w-[65ch]">{subtitle}</p>
    )
  }
</div>
