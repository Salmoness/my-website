---
interface Props {
  id: string;
  heading: string;
  summaryText?: string;
  initialOpen?: boolean;
  class?: string;
}

const { id, heading, summaryText, initialOpen = false, class: className = '' } = Astro.props;
---

<details
  id={id}
  open={initialOpen}
  class:list={[
    'specimen-drawer border border-[var(--color-ink-primary)] bg-[#FBF8F3] my-4 text-xs font-mono',
    className,
  ]}
>
  <summary
    class="cursor-pointer p-3 bg-[#EFE9DF] font-bold text-[var(--color-ink-primary)] select-none hover:bg-[var(--color-ink-primary)] hover:text-white transition-colors duration-150 focus-visible:outline-3 focus-visible:outline-[var(--color-signal-cobalt)] flex items-center justify-between"
  >
    <span>{heading}</span>
    {summaryText && <span class="text-xs font-normal opacity-75">{summaryText}</span>}
  </summary>
  <div
    class="drawer-content p-4 border-t border-[var(--color-ink-primary)] grid grid-cols-1 sm:grid-cols-2 gap-2 text-[var(--color-ink-primary)]"
  >
    <slot />
  </div>
</details>
