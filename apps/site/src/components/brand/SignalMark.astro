---
import { LOGO_MARK } from './logo-paths';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class:list={['signal-mark', className]}
  viewBox={`0 0 ${LOGO_MARK.width} ${LOGO_MARK.height}`}
  aria-hidden="true"
  focusable="false"
>
  <path class="azul-logo__tall" d={LOGO_MARK.tall}></path>
  <path class="azul-logo__small" d={LOGO_MARK.small}></path>
  <circle class="azul-logo__dot" cx={LOGO_MARK.dot.cx} cy={LOGO_MARK.dot.cy} r={LOGO_MARK.dot.r}
  ></circle>
</svg>
