---
interface Props {
  expanded?: boolean;
  headingId?: string;
}

const { expanded = false, headingId } = Astro.props;

const stages = [
  {
    title: 'Consultation',
    short: 'Find the real constraint before choosing a deliverable.',
    client: 'Context, pain points, priorities, and budget comfort.',
    azul: 'Listen, identify the highest-value starting point, and test fit.',
    output: 'A shared direction',
  },
  {
    title: 'Direction',
    short: 'Turn the conversation into a bounded, useful project.',
    client: 'Confirm goals, inputs, access, timing, and ideas to avoid.',
    azul: 'Define scope, exclusions, milestones, revisions, price, and ownership.',
    output: 'A written proposal',
  },
  {
    title: 'Implementation',
    short: 'Build the system and creative work in visible stages.',
    client: 'Supply accurate material, access, feedback, and approvals.',
    azul: 'Design, build, share milestones, and keep decisions understandable.',
    output: 'Approved work',
  },
  {
    title: 'Launch + handoff',
    short: 'Put the work in the client’s hands and clarify what comes next.',
    client: 'Own the accounts, domain, content, and final deliverables.',
    azul: 'Launch or deliver, document the handoff, and suggest only useful next steps.',
    output: 'A stronger presence',
  },
] as const;
---

<div
  class:list={['process-route', { 'process-route--expanded': expanded }]}
  aria-labelledby={headingId}
>
  <div class="process-route__legend" aria-hidden="true">
    <span>Conversation</span>
    <i></i>
    <span>Working presence</span>
  </div>
  <ol>
    {
      stages.map((stage, index) => (
        <li>
          <div class="process-route__node" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <i />
          </div>
          <div class="process-route__stage">
            <h3>{stage.title}</h3>
            <p>{stage.short}</p>
            {expanded && (
              <div class="process-route__handoff">
                <div>
                  <span>You bring</span>
                  <p>{stage.client}</p>
                </div>
                <div>
                  <span>Azul shapes</span>
                  <p>{stage.azul}</p>
                </div>
              </div>
            )}
          </div>
          <div class="process-route__output">
            <span>Leaves this phase</span>
            <strong>{stage.output}</strong>
          </div>
        </li>
      ))
    }
  </ol>
</div>
