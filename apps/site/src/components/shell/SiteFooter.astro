---
import SignalMark from '../brand/SignalMark.astro';
import { SITE, SITE_NAV, emailLink } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const email = emailLink(SITE.email);
---

<footer
  class:list={[
    'site-footer',
    'chapter-stack',
    'chapter-stack--medium',
    'chapter-stack--dark',
    className,
  ]}
>
  <section class="footer-conversation" aria-labelledby="footer-title">
    <div class="site-frame footer-conversation__layout">
      <h2 id="footer-title">Give people a clear reason to find you.</h2>
      <div>
        <p>
          Tell me what you’re working through. I’ll respond within two business days and we’ll
          arrange a free 20–30 minute call.
        </p>
        <a class="signal-link signal-link--light" href={SITE.consultationHref}>
          Let’s hop on a call
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </div>
    </div>
  </section>
  <div class="site-frame footer-main">
    <a href="/" class="footer-brand" aria-label={`${SITE.name} home`}>
      <SignalMark />
      <span>{SITE.name}</span>
    </a>
    <div class="footer-location">
      <span>{SITE.location}</span>
      <span>Central Florida + remote</span>
    </div>
    <div class="footer-contact">
      <span>Direct contact</span>
      {email ? <a href={email}>{SITE.email}</a> : <span>{SITE.email}</span>}
    </div>
  </div>
  <div class="site-frame footer-bottom">
    <span>© {new Date().getFullYear()} {SITE.operator}, operating as {SITE.name}</span>
    <div class="footer-links">
      {SITE_NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>
