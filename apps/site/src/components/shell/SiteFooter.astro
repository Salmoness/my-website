---
import { SITE, SITE_NAV, emailLink } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const email = emailLink(SITE.email);
---

<footer
  class:list={[
    'site-footer',
    'chapter-stack',
    'chapter-stack--medium',
    'chapter-stack--dark',
    className,
  ]}
>
  <section class="site-frame footer-cta" aria-labelledby="footer-title">
    <div class="footer-cta__title">
      <h2 id="footer-title">Give people a way to find you.</h2>
    </div>
    <div class="footer-cta__action">
      <p>Tell me what you’re working through.</p>
      <a class="signal-button" href={SITE.consultationHref}>
        <span>Let’s hop on a call</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
      </a>
    </div>
  </section>

  <div class="site-frame footer-index">
    <nav class="footer-index__nav" aria-label="Footer">
      <ul>
        {
          SITE_NAV.map((item, index) => (
            <li>
              <a href={item.href}>
                <span class="footer-index__num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="site-frame footer-base">
    <div class="footer-base__contact">
      {
        email ? (
          <a class="footer-base__email" href={email}>
            {SITE.email}
          </a>
        ) : (
          <span class="footer-base__email">{SITE.email}</span>
        )
      }
      <span>{SITE.location} · Central Florida + remote</span>
    </div>
    <div class="footer-legal">
      <span>© {new Date().getFullYear()} {SITE.operator}, operating as {SITE.name}</span>
      <div class="footer-legal__links">
        <a href="/privacy">Privacy</a>
        <a href="#top">Back to top ↑</a>
      </div>
    </div>
  </div>

  <p class="footer-wordmark" aria-hidden="true">{SITE.name}</p>
</footer>
