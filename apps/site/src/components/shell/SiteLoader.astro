---
import { Image } from 'astro:assets';
import heroCube from '../../assets/images/azul/hero-cube.png';
---

<div class="site-loader" data-site-loader aria-hidden="true">
  <div class="site-loader__stage">
    <div class="site-loader__mark">
      <Image src={heroCube} alt="" width={288} height={288} loading="eager" fetchpriority="high" />
    </div>
    <p class="site-loader__name"><strong>Azul</strong> Online Projects</p>
    <p class="site-loader__tagline">Media <span>·</span> Technology <span>·</span> Orlando</p>
    <div class="site-loader__progress">
      <span class="site-loader__track"
        ><span class="site-loader__fill" data-loader-fill></span></span
      >
      <span class="site-loader__meta">
        <span data-loader-status>Loading</span>
        <span data-loader-value>0%</span>
      </span>
    </div>
  </div>
</div>

<script src="../../scripts/site-loader.ts"></script>

<style is:global>
  .site-loader {
    --loader-width: 16rem;
    --loader-progress: 0;

    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    place-items: center;
    padding: 1.5rem;
    color: var(--color-cloud-white);
    background:
      radial-gradient(ellipse 42% 55% at 27% 32%, rgba(255, 111, 97, 0.12), transparent 72%),
      radial-gradient(ellipse 48% 58% at 63% 36%, rgba(84, 167, 216, 0.15), transparent 72%),
      radial-gradient(ellipse 120% 95% at 50% 45%, transparent 38%, rgba(2, 8, 14, 0.88) 100%),
      var(--color-night-stage);
    transition:
      opacity 400ms var(--ease-signal),
      visibility 0s linear 400ms;
  }

  .site-loader::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(237, 242, 245, 0.045) 1px, transparent 1.3px);
    background-size: 4px 4px;
    pointer-events: none;
  }

  html.is-loading {
    overflow: hidden;
  }

  html.is-loading .site-loader {
    display: grid;
  }

  .site-loader__stage {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    transition: transform 400ms var(--ease-signal);
  }

  .site-loader__mark {
    width: 8.5rem;
    aspect-ratio: 1;
    filter: drop-shadow(0 0 2.25rem rgba(84, 167, 216, 0.26));
    animation: site-loader-float 3.4s ease-in-out infinite;
  }

  .site-loader__mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-loader .site-loader__name {
    margin: 2.1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 420;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .site-loader .site-loader__name strong {
    font-weight: 750;
  }

  .site-loader .site-loader__tagline {
    margin: 1.2rem 0 0;
    padding-left: 0.3em;
    color: var(--color-azul-mist);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-loader__tagline span {
    opacity: 0.6;
  }

  .site-loader__progress {
    width: var(--loader-width);
    margin-top: 2.4rem;
  }

  .site-loader__track {
    display: block;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(168, 200, 217, 0.14);
  }

  .site-loader__fill {
    display: block;
    width: calc(var(--loader-progress) * 100%);
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--color-coral-signal),
      #f3c2ad 46%,
      var(--color-azul-electric)
    );
    background-size: var(--loader-width) 100%;
  }

  .site-loader__meta {
    display: flex;
    justify-content: space-between;
    margin-top: 0.85rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-loader.is-leaving {
    opacity: 0;
    visibility: hidden;
  }

  .site-loader.is-leaving .site-loader__stage {
    transform: translateY(-0.5rem) scale(0.985);
  }

  @keyframes site-loader-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-5px) rotate(1.5deg);
    }
  }

  @media (max-width: 40rem) {
    .site-loader {
      --loader-width: min(16rem, 78vw);
    }

    .site-loader__mark {
      width: 7rem;
    }

    .site-loader .site-loader__name {
      font-size: 1.4rem;
    }

    .site-loader .site-loader__tagline {
      letter-spacing: 0.24em;
      padding-left: 0.24em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-loader {
      transition-duration: 200ms;
    }

    .site-loader__mark {
      animation: none;
    }

    .site-loader.is-leaving .site-loader__stage {
      transform: none;
    }
  }

  html[data-motion='off'] .site-loader__mark {
    animation: none;
  }
</style>
