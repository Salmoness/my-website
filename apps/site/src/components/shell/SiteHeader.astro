---
import PrimaryNav from './PrimaryNav.astro';
import Arrow from '../portfolio/Arrow.astro';
import { PORTFOLIO } from '../../config/site';
import type { MainRoute } from '../../types/site';
interface Props {
  activeRoute?: MainRoute | undefined;
  class?: string | undefined;
}
const { activeRoute, class: className = '' } = Astro.props;
---

<header class:list={['site-header', className]}>
  <div class="site-wrap header-row">
    <a href="/" class="brand-link"
      ><span class="brand-mark" aria-hidden="true"></span>{PORTFOLIO.name}<span class="brand-dot"
        >.</span
      ></a
    >
    <PrimaryNav activeRoute={activeRoute} />
    <a href="#contact" class="header-contact">Let's talk <Arrow diagonal /></a>
  </div>
</header>
