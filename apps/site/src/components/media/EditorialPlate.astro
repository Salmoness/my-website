---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  label: string;
  caption: string;
  code?: string;
  className?: string;
  compact?: boolean;
  position?: string;
}

const {
  image,
  alt,
  label,
  caption,
  code = 'Azul field study',
  className,
  compact = false,
  position = '50% 50%',
} = Astro.props;

const widths = compact ? [360, 640, 900, image.width] : [640, 960, 1440, 1920, image.width];
const sizes = compact
  ? '(max-width: 42rem) calc(100vw - 2rem), (max-width: 76rem) 45vw, 28rem'
  : '(max-width: 58rem) calc(100vw - 2rem), (max-width: 100rem) calc(100vw - 4rem), 94rem';
---

<figure class:list={['editorial-plate', { 'editorial-plate--compact': compact }, className]}>
  <div class="editorial-plate__frame" style={`--media-position: ${position}`}>
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={compact ? 76 : 80}
      loading="lazy"
      decoding="async"
    />
    <span aria-hidden="true">{code}</span>
  </div>
  <figcaption>
    <span>{label}</span>
    <p>{caption}</p>
  </figcaption>
</figure>
