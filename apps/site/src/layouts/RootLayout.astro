---
import '../styles/global.css';
import { SITE_MODE } from 'astro:env/server';
import FogField from '../components/brand/FogField.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import SiteLoader from '../components/shell/SiteLoader.astro';
import type { PageMetadata, SiteMetadata, MainRoute } from '../types/site';
import { DEFAULT_PAGE_METADATA, PORTFOLIO, SITE, getPageSharing } from '../config/site';

interface Props {
  metadata?: PageMetadata | SiteMetadata | undefined;
  activeRoute?: MainRoute | undefined;
}

const { metadata = DEFAULT_PAGE_METADATA['/'], activeRoute } = Astro.props;
const lang = metadata.lang ?? 'en';
const charset = metadata.charset ?? 'UTF-8';
const title = metadata.title;
const description = metadata.description;
const { canonicalUrl, imageUrl, imageAlt } = getPageSharing(
  'canonicalPath' in metadata ? metadata : { ...metadata, canonicalPath: Astro.url.pathname },
  PORTFOLIO,
);
/** Home only: runs before first paint to show the loader, with a hard failsafe. */
const showLoader = SITE.loaderEnabled && activeRoute === '/';
const LOADER_BOOT = `(function(){var d=document.documentElement;d.classList.add('is-loading');setTimeout(function(){d.classList.remove('is-loading');},6000);})();`;

const isStaging =
  (SITE_MODE ?? 'staging') === 'staging' || ('noindex' in metadata && metadata.noindex);
---

<!doctype html>
<html lang={lang} data-motion={SITE.motionEnabled ? 'on' : 'off'}>
  <head>
    <meta charset={charset} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071A2B" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {isStaging && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {imageUrl && <meta name="twitter:card" content="summary_large_image" />}
    <title>{title}</title>
    {showLoader && <script is:inline set:html={LOADER_BOOT} />}
  </head>
  <body class="azul-site">
    {showLoader && <SiteLoader />}
    <a href="#main-content" id="skip-to-content" class="skip-link">Skip to main content</a>
    <div class:list={['site-plane', { 'site-plane--home': activeRoute === '/' }]}>
      {SITE.scrollFogEnabled && <FogField />}
      <SiteHeader activeRoute={activeRoute} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    {SITE.scrollFogEnabled && <script src="../scripts/fog-field.ts" />}
  </body>
</html>
