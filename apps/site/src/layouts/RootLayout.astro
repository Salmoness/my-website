---
import '../styles/global.css';
import { SITE_MODE } from 'astro:env/server';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import type { PageMetadata, SiteMetadata, MainRoute } from '../types/site';
import { DEFAULT_PAGE_METADATA, PORTFOLIO, getPageSharing } from '../config/site';

interface Props {
  metadata?: PageMetadata | SiteMetadata | undefined;
  activeRoute?: MainRoute | undefined;
}

const { metadata = DEFAULT_PAGE_METADATA['/'], activeRoute } = Astro.props;

const lang = metadata.lang ?? 'en';
const charset = metadata.charset ?? 'UTF-8';
const title = metadata.title;
const description = metadata.description;
const { canonicalUrl, imageUrl, imageAlt } = getPageSharing(
  'canonicalPath' in metadata ? metadata : { ...metadata, canonicalPath: Astro.url.pathname },
);

const isStaging =
  (SITE_MODE ?? 'staging') === 'staging' || ('noindex' in metadata && metadata.noindex);
---

<!doctype html>
<html lang={lang} data-motion={PORTFOLIO.motionEnabled ? 'on' : 'off'}>
  <head>
    <meta charset={charset} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {isStaging && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PORTFOLIO.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <title>{title}</title>
  </head>
  <body class="portfolio-site">
    <!-- Accessible Skip Link -->
    <a
      href="#main-content"
      id="skip-to-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-[var(--color-signal-action)] focus:text-white focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:uppercase focus:outline-3 focus:outline-[var(--color-signal-cobalt)] focus:border-2 focus:border-[var(--color-ink-primary)] shadow-[4px_4px_0px_var(--color-ink-primary)]"
    >
      Skip to main content
    </a>

    <!-- Primary Header -->
    <SiteHeader activeRoute={activeRoute} />

    <!-- Exactly one Main Landmark -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Site Footer -->
    <SiteFooter />

    <!-- Progressive enhancement for hash-targeted disclosures -->
    <script src="../scripts/disclosure-hash.ts"></script>
    <script src="../scripts/portfolio-motion.ts"></script>
  </body>
</html>
