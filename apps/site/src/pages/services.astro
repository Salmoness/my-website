---
import EnquiryForm from '../components/contact/EnquiryForm.astro';
import RouteHeroMedia from '../components/media/RouteHeroMedia.astro';
import ServiceGuide from '../components/services/ServiceGuide.astro';
import RootLayout from '../layouts/RootLayout.astro';
import { DEFAULT_PAGE_METADATA, SITE } from '../config/site';
import systemsContentStudio from '../assets/images/azul/systems-content-studio.png';

const maintenancePrice = SITE.maintenancePrice.trim();
const quoted = 'Quoted after the call';

const jumpLinks = [
  { href: '#packages', label: 'Packages' },
  { href: '#pricing', label: 'One-time or ongoing' },
  { href: '#services', label: 'Every service' },
  { href: '#service-guide', label: 'Help me choose' },
  { href: '#questions', label: 'Questions' },
] as const;

/** Icon paths share the Home page's systems + media icon set. */
const icons = {
  website:
    '<rect x="3" y="4.5" width="18" height="15" rx="2.5"></rect><path d="M3 9h18M6.5 6.75h.01M9 6.75h.01"></path>',
  crm: '<circle cx="9" cy="8.5" r="3.25"></circle><path d="M3.5 19c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5M15.5 5.5h5M15.5 9h5M17.5 12.5h3"></path>',
  automations: '<path d="M13 3 5 13.5h6L10 21l8-10.5h-6z"></path>',
  followups: '<path d="M4 5.5h16v10H9.5L5 19.5v-4H4zM8 9.5h8M8 12h5"></path>',
  content:
    '<rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="m10 9 5 3-5 3z"></path>',
  social:
    '<rect x="4" y="4" width="16" height="16" rx="4.5"></rect><circle cx="12" cy="12" r="3.5"></circle><path d="M16.5 7.5h.01"></path>',
  google:
    '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"></path><circle cx="12" cy="10" r="2.4"></circle>',
  ads: '<path d="M4 10v4h3l6 4V6L7 10zM16.5 9a4 4 0 0 1 0 6M19 6.5a7.5 7.5 0 0 1 0 11"></path>',
} as const;

interface Service {
  id: string;
  icon: keyof typeof icons;
  name: string;
  tagline: string;
  price: string;
  priceNote?: string;
  includes: readonly string[];
  boundary: string;
  interest: string;
}

const systems: readonly Service[] = [
  {
    id: 'web-development',
    icon: 'website',
    name: 'Website',
    tagline: 'A clear site that explains what you offer and makes it easy to call.',
    price: '$800–$3,500',
    priceNote: maintenancePrice
      ? `one time, plus ${maintenancePrice}/mo maintenance`
      : 'one time, plus monthly maintenance',
    includes: [
      'Custom design that works well on phones',
      'A clear offer and an easy way to get in touch',
      'Search and social-sharing basics',
      'Launch, handoff, and a walkthrough',
      maintenancePrice
        ? `Hosting, updates, and support after launch for ${maintenancePrice} a month`
        : 'Hosting, updates, and support after launch for a monthly fee',
    ],
    boundary: 'Online stores, member portals, and custom apps are scoped separately.',
    interest: 'Web development',
  },
  {
    id: 'crm',
    icon: 'crm',
    name: 'CRM',
    tagline: 'Every enquiry in one place, so nothing slips through a notebook.',
    price: quoted,
    priceNote: 'setup',
    includes: [
      'A CRM set up around how you already work',
      'Website and social enquiries flow straight in',
      'Simple stages, so you always know who needs a reply',
      'A walkthrough for you and your team',
      'Monthly CRM management if you want it, quoted after the call',
    ],
    boundary: 'The CRM account is yours. Its subscription is billed by the provider.',
    interest: 'CRM & automations',
  },
  {
    id: 'automations',
    icon: 'automations',
    name: 'Automations',
    tagline: 'Confirmations, reminders, and hand-offs that run on their own.',
    price: quoted,
    priceNote: 'setup',
    includes: [
      'Instant confirmations when someone reaches out',
      'Appointment and follow-up reminders',
      'Hand-offs between your forms, inbox, and CRM',
      'Written down, so you know what runs and when',
    ],
    boundary: 'Built on tools you own. Some tools carry their own subscription.',
    interest: 'CRM & automations',
  },
  {
    id: 'follow-ups',
    icon: 'followups',
    name: 'Follow-ups',
    tagline: 'Timely replies by text, WhatsApp, or email, so leads don’t go cold.',
    price: quoted,
    priceNote: 'setup',
    includes: [
      'Reply templates written in your voice',
      'Follow-up sequences by text, WhatsApp, or email',
      'Nudges for leads that haven’t answered yet',
      'Connected to your CRM if you have one',
    ],
    boundary: 'WhatsApp Business and text messaging can carry their own platform fees.',
    interest: 'Follow-ups',
  },
];

const media: readonly Service[] = [
  {
    id: 'social-content',
    icon: 'content',
    name: 'Content',
    tagline: 'Short videos, photos, and posts that show your work.',
    price: '$400–$1,500',
    priceNote: 'per project',
    includes: [
      'Ideas, hooks, scripts, and captions',
      'Editing and platform-ready cuts',
      'Graphics and approved AI-assisted assets',
    ],
    boundary: 'On-location filming and unlimited revisions aren’t included by default.',
    interest: 'Social Content',
  },
  {
    id: 'meta-business',
    icon: 'social',
    name: 'Social strategy',
    tagline: 'A posting plan for Instagram and Facebook, so people keep seeing you.',
    price: '$300–$900',
    priceNote: 'setup',
    includes: [
      'Account setup or cleanup',
      'Profiles that match your brand and offer',
      'A posting plan and scheduling',
      'Monthly management, quoted after the call or included in Ongoing Visibility',
    ],
    boundary: 'Account approval is up to Meta and can’t be guaranteed.',
    interest: 'Meta Business',
  },
  {
    id: 'google-business',
    icon: 'google',
    name: 'Google Business Profile',
    tagline: 'Show up clearly when people look for you nearby.',
    price: '$300–$900',
    priceNote: 'setup',
    includes: [
      'Setup, or fixing a profile that already exists',
      'Services, hours, and photos that answer questions',
      'A simple way to ask happy customers for reviews',
    ],
    boundary: 'Verification and ranking are up to Google and can’t be guaranteed.',
    interest: 'Google Business Profile',
  },
  {
    id: 'paid-ads',
    icon: 'ads',
    name: 'Google Ads + Meta Ads',
    tagline: 'Show up when people search, and reach nearby customers on Facebook and Instagram.',
    price: quoted,
    priceNote: 'monthly management',
    includes: [
      'Campaigns built around one clear goal',
      'Ads written and designed for your offer',
      'Budget and targeting tuned as results come in',
      'Plain-language reports on what your money did',
    ],
    boundary:
      'Ad spend is paid to Google or Meta directly and isn’t part of the fee. Results can’t be guaranteed.',
    interest: 'Google or Meta ads',
  },
];

const menus = [
  {
    key: 'systems',
    eyebrow: 'Your systems',
    title: 'Turn interest into customers.',
    services: systems,
  },
  {
    key: 'media',
    eyebrow: 'Your media',
    title: 'Get found without knocking on doors.',
    services: media,
  },
] as const;

const faqs = [
  [
    'What’s paid once, and what’s monthly?',
    'Anything I build or set up is paid once: your website, content projects, and setting up your Google profile, social accounts, CRM, or automations. Work I keep doing for you is billed monthly: website maintenance, social media management, running your ads or CRM, and analytics and strategy.',
  ],
  [
    'What does website maintenance cover?',
    `Hosting, updates, and support, so your site stays online and current${maintenancePrice ? `. It usually runs ${maintenancePrice} a month, depending on the site` : ''}. Every website I build has it, and the exact fee is in your proposal.`,
  ],
  [
    'Do I own my website?',
    'Yes. You pay for the build once, and the site, your domain, and your content are yours. The monthly maintenance fee pays for keeping it hosted and up to date.',
  ],
  [
    'Is ad spend included in ad management?',
    'No. What you spend on Google or Meta ads is paid to them directly, and you set the budget. My fee covers setting up, running, and reporting on the campaigns.',
  ],
  [
    'What changes the final price?',
    'Scope, what already exists, timing, source material, access, and unusual integrations. The ranges here are typical; your written proposal sets the exact price.',
  ],
  [
    'What will you need from me?',
    'Accurate business information, timely access to accounts, usable photos or material where relevant, one set of combined feedback, and approvals at each milestone.',
  ],
  [
    'Can you improve what I already have?',
    'Yes. If part of your website, profile, or content already works, fixing the rest usually makes more sense than starting over.',
  ],
  [
    'Do you guarantee rankings, views, enquiries, or sales?',
    'No. I can make your business clearer and easier to find and contact, but platforms, audiences, competition, and the business itself also shape results.',
  ],
  [
    'How is AI used for content?',
    'I use it as a tool for planning, scripting, editing, and assets you approve. Nothing goes out without your OK.',
  ],
] as const;
---

<RootLayout metadata={DEFAULT_PAGE_METADATA['/services']} activeRoute="/services">
  <section class="route-hero route-hero--photo pg-hero" aria-labelledby="services-title">
    <RouteHeroMedia image={systemsContentStudio} />
    <div class="site-frame pg-hero__layout">
      <p class="pg-eyebrow">Services and pricing</p>
      <h1 id="services-title">
        Take the whole foundation,<br /><span>or just the piece you’re missing.</span>
      </h1>
      <div class="pg-hero__card dot-card">
        <p class="pg-hero__lede">
          Two packages cover what most small businesses need, and every service also works on its
          own. Building and setup are paid once. Work I keep doing for you, like website maintenance
          or social media, is billed monthly.
        </p>
        <ul class="pg-hero__points">
          <li>Typical prices on every service</li>
          <li>Buy only the pieces you need</li>
          <li>An exact quote after a free call</li>
        </ul>
        <div class="pg-hero__actions">
          <a class="signal-button" href="#contact">
            <span>Let’s hop on a call</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg
            >
          </a>
          <a class="signal-link" href="#service-guide">
            Help me choose
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13M5 12l5 5 5-5"></path></svg
            >
          </a>
        </div>
      </div>
    </div>
    <nav class="site-frame pg-jump" aria-label="On this page">
      <ol>
        {
          jumpLinks.map((link, index) => (
            <li>
              <a href={link.href}>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <section
    id="packages"
    class="pg-section pg-light svc-packages chapter-stack chapter-stack--wide chapter-stack--light chapter-stack--accent"
    aria-labelledby="packages-title"
  >
    <div class="site-frame pg-head">
      <div>
        <p class="pg-eyebrow">Packages</p>
        <h2 id="packages-title">Two packages.<br /><span>Pick one, or pair them.</span></h2>
      </div>
      <p>
        Most businesses start with the Online Foundation, then keep it active with Ongoing
        Visibility. Prices are typical ranges, and your exact quote comes in writing after a free
        call.
      </p>
    </div>

    <div class="site-frame packages svc-packages__grid">
      <article
        class="package-card package-card--foundation"
        id="online-foundation"
        aria-labelledby="svc-foundation"
      >
        <p class="package-card__kicker"><span>1</span> One-time project</p>
        <h3 id="svc-foundation">Online Foundation</h3>
        <p class="package-card__fit">
          Your website, Google profile, and social accounts, set up so people can find you and get
          in touch.
        </p>
        <div class="package-card__price">
          <strong>$1,500–$4,000</strong>
          <span>one time · typical range</span>
        </div>
        <ul class="package-card__list">
          <li>Custom, mobile-friendly website (up to five pages)</li>
          <li>A clear enquiry path and contact actions</li>
          <li>Google Business Profile setup or cleanup</li>
          <li>Facebook and Instagram business setup</li>
          <li>Search and social-sharing basics</li>
          <li>Handoff and training, with everything in your name</li>
        </ul>
        <dl class="svc-facts">
          <div>
            <dt>Best for</dt>
            <dd>New or very small businesses that don’t have a dependable website yet.</dd>
          </div>
          <div>
            <dt>Timing</dt>
            <dd>Usually 3–6 weeks once content and access are ready.</dd>
          </div>
          <div>
            <dt>After launch</dt>
            <dd>
              Website maintenance{maintenancePrice ? `, ${maintenancePrice} a month` : ''}: hosting,
              updates, and support.
            </dd>
          </div>
          <div>
            <dt>Billed separately</dt>
            <dd>Your domain and any software subscriptions.</dd>
          </div>
        </dl>

        <div class="package-card__actions">
          <a class="signal-button" href="#contact" data-interest="Online Foundation">
            <span>Start with the foundation</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg
            >
          </a>
        </div>
      </article>

      <div class="packages__join" aria-hidden="true">
        <span class="packages__join-mark"
          ><svg viewBox="0 0 20 20"><path d="M4 10h11M11 5l5 5-5 5"></path></svg></span
        >
        <span class="packages__join-label">then</span>
      </div>

      <article
        class="package-card package-card--visibility"
        id="ongoing-visibility"
        aria-labelledby="svc-visibility"
      >
        <p class="package-card__kicker"><span>2</span> Monthly support</p>
        <h3 id="svc-visibility">Ongoing Visibility</h3>
        <p class="package-card__fit">
          Keeps your business active and easy to find once the foundation is in place.
        </p>
        <div class="package-card__price">
          <strong>$600–$1,800</strong>
          <span>per month · typical range</span>
        </div>
        <ul class="package-card__list">
          <li>Google Business Profile upkeep</li>
          <li>Facebook and Instagram management</li>
          <li>Content planning and scheduling</li>
          <li>Short videos, graphics, and captions made for you</li>
          <li>A regular review of what’s working and what’s next</li>
        </ul>
        <dl class="svc-facts">
          <div>
            <dt>Best for</dt>
            <dd>Operating businesses ready for a steady rhythm of posts and updates.</dd>
          </div>
          <div>
            <dt>Cadence</dt>
            <dd>Platforms, posting rhythm, and deliverables agreed in your proposal.</dd>
          </div>
          <div>
            <dt>Add when ready</dt>
            <dd>Google or Meta ads, a CRM, and automatic follow-ups.</dd>
          </div>
        </dl>
        <div class="package-card__actions">
          <a class="signal-button" href="#contact" data-interest="Ongoing Visibility">
            <span>Keep it growing</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg
            >
          </a>
        </div>
      </article>
    </div>
  </section>

  <section
    id="pricing"
    class="pg-section pg-dark svc-pay chapter-stack chapter-stack--medium chapter-stack--dark chapter-stack--foreground"
    aria-labelledby="pay-title"
  >
    <div class="site-frame pg-head pg-head--stacked">
      <p class="pg-eyebrow">How pricing works</p>
      <h2 id="pay-title">Build it once.<br /><span>Keep it running monthly.</span></h2>
      <p>
        Anything I build or set up is paid once. Anything I keep doing for you is billed monthly.
        Every website comes with a small monthly maintenance fee that keeps it online and up to
        date.
      </p>
    </div>

    <ol class="site-frame price-line">
      <li class="price-stage price-stage--once">
        <div class="price-stage__rail" aria-hidden="true">
          <span class="price-stage__node">$</span>
          <span class="price-stage__tag">One payment</span>
        </div>
        <p class="price-stage__when">Before launch</p>
        <h3>Paid once</h3>
        <p class="price-stage__lede">Anything I build or set up for you.</p>
        <dl class="price-ledger">
          <div class="price-ledger__lead">
            <dt>Website</dt>
            <dd>$800–$3,500</dd>
          </div>
          <div>
            <dt>Content projects</dt>
            <dd>$400–$1,500</dd>
          </div>
          <div>
            <dt>Google Business Profile setup</dt>
            <dd>$300–$900</dd>
          </div>
          <div>
            <dt>Facebook and Instagram setup</dt>
            <dd>$300–$900</dd>
          </div>
          <div>
            <dt>CRM, automation, or follow-up setup</dt>
            <dd>{quoted}</dd>
          </div>
        </dl>
        <a class="signal-link" href="#contact" data-interest="Web development">
          Ask about a project
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </li>

      <li class="price-stage price-stage--monthly">
        <div class="price-stage__rail" aria-hidden="true">
          <span class="price-stage__node price-stage__node--flag"
            ><svg viewBox="0 0 20 20"
              ><path d="M5.5 17.5V3"></path><path d="M5.5 3.5h9l-2.2 3.2 2.2 3.3h-9z"></path></svg
            ></span
          >
          <span class="price-stage__tag">Launch</span>
          <span class="price-stage__months">
            {Array.from({ length: 12 }, (_, month) => <i style={`--i: ${month}`} />)}
          </span>
        </div>
        <p class="price-stage__when">Every month after launch</p>
        <h3>Billed monthly</h3>
        <div class="price-meter">
          <strong>{maintenancePrice || quoted}{maintenancePrice && <small>/mo</small>}</strong>
          <p><b>Website maintenance</b> on every website: hosting, updates, and support.</p>
        </div>
        <p class="price-stage__label">Add any of these if you want them</p>
        <ul class="price-addons">
          <li>Social media management</li>
          <li>Running your Google or Meta ads</li>
          <li>Managing your CRM and automations</li>
          <li>Analytics and strategy</li>
        </ul>
        <p class="price-stage__note">
          Quoted after the call. Social media and content also come bundled in{' '}<a
            href="#ongoing-visibility">Ongoing Visibility</a
          >.
        </p>
        <a class="signal-link" href="#contact" data-interest="Ongoing management">
          Ask about monthly work
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </li>
    </ol>

    <div class="site-frame svc-pay__always">
      <span>With every project</span>
      <ul>
        <li>Built for your business</li>
        <li>Your domain in your name</li>
        <li>Your content stays yours</li>
        <li>A launch walkthrough</li>
      </ul>
    </div>
  </section>

  <section
    id="services"
    class="pg-section pg-light svc-menu chapter-stack chapter-stack--medium chapter-stack--light"
    aria-labelledby="menu-title"
  >
    <div class="site-frame pg-head">
      <div>
        <p class="pg-eyebrow">Every service</p>
        <h2 id="menu-title">Need one piece?<br /><span>Every service works on its own.</span></h2>
      </div>
      <p>
        Your systems turn interest into customers. Your media brings people in. Open any service to
        see what’s included, what it costs, and what’s up to the platform.
      </p>
    </div>

    <div class="site-frame svc-index">
      {
        menus.map((menu, menuIndex) => {
          const offset = menuIndex === 0 ? 0 : menus[0].services.length;
          return (
            <section
              class:list={['svc-index__group', `svc-index__group--${menu.key}`]}
              aria-labelledby={`menu-${menu.key}`}
            >
              <header class="svc-index__label">
                <span class="svc-index__letter" aria-hidden="true">
                  {menuIndex === 0 ? 'A' : 'B'}
                </span>
                <p class="svc-index__eyebrow">{menu.eyebrow}</p>
                <h3 id={`menu-${menu.key}`}>{menu.title}</h3>
                <p class="svc-index__range">
                  {`Services ${String(offset + 1).padStart(2, '0')}–${String(offset + menu.services.length).padStart(2, '0')}`}
                </p>
              </header>
              <ol class="svc-index__list">
                {menu.services.map((service, serviceIndex) => (
                  <li class="svc-row" id={service.id}>
                    <details data-animated-disclosure>
                      <summary>
                        <span class="svc-row__num" aria-hidden="true">
                          {String(offset + serviceIndex + 1).padStart(2, '0')}
                        </span>
                        <span class="svc-row__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" set:html={icons[service.icon]} />
                        </span>
                        <span class="svc-row__name">
                          <strong>{service.name}</strong>
                          <span>{service.tagline}</span>
                        </span>
                        <span class="svc-row__price">
                          <strong>{service.price}</strong>
                          {service.priceNote && <small>{service.priceNote}</small>}
                        </span>
                        <span class="svc-row__toggle" aria-hidden="true" />
                      </summary>
                      <div class="svc-row__detail" data-disclosure-body>
                        <div class="svc-row__detail-inner">
                          <div class="svc-row__includes">
                            <p class="svc-row__label">What’s included</p>
                            <ul>
                              {service.includes.map((item) => (
                                <li>{item}</li>
                              ))}
                            </ul>
                          </div>
                          <div class="svc-stub">
                            <span class="svc-stub__label">Typical price</span>
                            <strong>{service.price}</strong>
                            {service.priceNote && <small>{service.priceNote}</small>}
                            <p class="svc-stub__fine">{service.boundary}</p>
                            <a
                              class="signal-link signal-link--dark"
                              href="#contact"
                              data-interest={service.interest}
                            >
                              Ask about {service.name}
                              <svg viewBox="0 0 20 20" aria-hidden="true">
                                <path d="M4 10h11M11 5l5 5-5 5" />
                              </svg>
                            </a>
                          </div>
                        </div>
                      </div>
                    </details>
                  </li>
                ))}
              </ol>
            </section>
          );
        })
      }
    </div>

    <p class="site-frame svc-menu__foot">
      Not sure which pieces you need? <a href="#service-guide">Answer three quick questions</a>
    </p>
  </section>

  <div
    id="service-guide"
    class="guide-field svc-guide chapter-stack chapter-stack--narrow chapter-stack--dark chapter-stack--foreground"
  >
    <div class="site-frame"><ServiceGuide /></div>
  </div>

  <section
    id="questions"
    class="pg-section pg-light svc-faq chapter-stack chapter-stack--medium chapter-stack--light"
    aria-labelledby="faq-title"
  >
    <div class="site-frame faq-layout">
      <div>
        <p class="pg-eyebrow">Questions</p>
        <h2 id="faq-title">Before you<br /><span>get in touch.</span></h2>
        <p>
          These come up most before a first call. For how the work runs, timing, and ownership, see <a
            href="/how-we-work">How We Work</a
          >.
        </p>
      </div>
      <div class="faq-list">
        {
          faqs.map(([question, answer]) => (
            <details data-animated-disclosure>
              <summary>
                {question}
                <span aria-hidden="true" />
              </summary>
              <div class="faq-answer">
                <p>{answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <div class="enquiry-field chapter-stack chapter-stack--wide chapter-stack--slate">
    <div class="site-frame"><EnquiryForm /></div>
  </div>
</RootLayout>

