---
import { Image } from 'astro:assets';
import RootLayout from '../layouts/RootLayout.astro';
import ProcessRoute from '../components/brand/ProcessRoute.astro';
import SignalMark from '../components/brand/SignalMark.astro';
import EditorialPlate from '../components/media/EditorialPlate.astro';
import { DEFAULT_PAGE_METADATA, SITE } from '../config/site';
import storefrontVisibility from '../assets/images/azul/storefront-visibility.png';
import webDevelopment from '../assets/images/azul/web-development.png';
import localDiscovery from '../assets/images/azul/local-discovery.png';
import metaBusiness from '../assets/images/azul/meta-business.png';
import socialContent from '../assets/images/azul/social-content.png';
import heroCube from '../assets/images/azul/hero-cube.png';
import heroShadow from '../assets/images/azul/hero-shadow-stage.png';

const capabilities = [
  {
    id: 'web-development',
    title: 'Web development',
    headline: 'Give people a place to land.',
    text: 'A focused website makes the offer clear, builds trust, and gives every other channel a useful destination.',
    image: webDevelopment,
    imageAlt: 'Hands refine a responsive website layout across a laptop and tablet.',
  },
  {
    id: 'google-business',
    title: 'Google Business Profile',
    headline: 'Show up when they look nearby.',
    text: 'A useful local profile helps people find the business, understand the essentials, and take the next step.',
    image: localDiscovery,
    imageAlt:
      'A phone with a local-discovery layout is held in front of a neighborhood storefront.',
  },
  {
    id: 'meta-business',
    title: 'Meta Business',
    headline: 'Connect the places you show up.',
    text: 'Organized Facebook and Instagram business profiles make the presence feel consistent and easier to manage.',
    image: metaBusiness,
    imageAlt: 'A business-profile workflow is arranged across several devices and content cards.',
  },
  {
    id: 'social-content',
    title: 'Social Content',
    headline: 'Give people a reason to return.',
    text: 'Useful ideas become content that shows the business in motion and points people back to its services.',
    image: socialContent,
    imageAlt: 'A compact content shoot uses a phone, small light, storyboard, and editing screen.',
  },
] as const;
---

<RootLayout metadata={DEFAULT_PAGE_METADATA['/']} activeRoute="/">
  <section class="azul-hero" aria-labelledby="hero-title">
    <div class="hero-shadow" aria-hidden="true">
      <Image src={heroShadow} alt="" loading="eager" />
    </div>
    <div class="hero-sculpture" aria-hidden="true">
      <Image src={heroCube} alt="" loading="eager" />
    </div>
    <div class="site-frame hero-stage">
      <div class="hero-copy">
        <h1 id="hero-title">Grow your <span>online</span> <span>identity.</span></h1>
        <p class="hero-lede">{SITE.supportingLine}</p>
        <div class="hero-actions">
          <a class="signal-button" href={SITE.consultationHref}>
            <span>Let’s hop on a call</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg
            >
          </a>
          <a class="signal-link" href="/services">
            Explore services
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg
            >
          </a>
        </div>
        <p class="hero-location">Orlando rooted · Central Florida + remote</p>
      </div>
    </div>
  </section>

  <section
    class="problem-section chapter-stack chapter-stack--wide chapter-stack--light"
    aria-labelledby="problem-title"
  >
    <div class="site-frame problem-layout">
      <div class="problem-statement">
        <h2 id="problem-title">Great work can still be easy to miss.</h2>
        <p>
          People look online before they call, visit, or buy. A scattered profile—or no useful
          answer at all—turns that moment of interest into uncertainty.
        </p>
      </div>
      <EditorialPlate
        image={storefrontVisibility}
        alt="A small-business owner prepares a softly lit neighborhood storefront before opening."
        label="Visibility starts before the first click"
        caption="A professional presence carries the care already happening behind the door into the moment a customer starts looking."
        code="01 / Ready for business"
        className="problem-plate"
        position="58% 50%"
      />
      <div class="discovery-route" aria-label="A customer's path from search to contact">
        <div class="discovery-route__track" aria-hidden="true"></div>
        <div><span>Search</span><strong>Can I find you?</strong></div>
        <div><span>Understand</span><strong>Is this for me?</strong></div>
        <div><span>Trust</span><strong>Does this feel ready?</strong></div>
        <div><span>Contact</span><strong>What do I do next?</strong></div>
      </div>
      <div class="problem-resolution">
        <p>
          Azul connects those answers into one professional presence: a clear offer, signs of an
          active business, and a direct path to start the conversation.
        </p>
        <a class="signal-link signal-link--dark" href="/how-we-work">
          See how the work comes together
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <section
    class="intersection-section chapter-stack chapter-stack--narrow chapter-stack--dark chapter-stack--foreground"
    aria-labelledby="intersection-title"
  >
    <div class="site-frame intersection-intro">
      <h2 id="intersection-title">Build the ground.<br /><span>Send the signal.</span></h2>
      <p>
        A strong website without attention sits quietly. Content without a dependable destination
        scatters interest. Each side is more useful when the other has a job.
      </p>
    </div>
    <div class="site-frame intersection-map" aria-label="How Azul connects systems and media">
      <div class="intersection-lane">
        <span>Systems sharpen the business</span>
        <strong>Clear offer</strong><strong>Credible home</strong><strong>Reliable contact</strong>
      </div>
      <div class="intersection-core">
        <SignalMark />
        <span>One coherent presence</span>
      </div>
      <div class="intersection-lane intersection-lane--right">
        <span>Media brings people toward it</span>
        <strong>Useful ideas</strong><strong>Active profiles</strong><strong
          >Recognizable voice</strong
        >
      </div>
    </div>
  </section>

  <section
    class="offers-section chapter-stack chapter-stack--medium chapter-stack--light"
    aria-label="Ways to work with Azul"
  >
    <div class="site-frame offers-heading">
      <p>
        Choose a connected foundation or focus on the one piece creating the most friction. Every
        final scope is shaped around the business; every capability can stand on its own.
      </p>
    </div>

    <div class="site-frame offer-ledger">
      <article id="home-foundation">
        <div class="offer-ledger__title">
          <h2>Online Foundation</h2>
          <span>$1,500–$4,000 typical · one time</span>
        </div>
        <p>A coordinated starting point that makes a new or tiny business look established.</p>
        <ul>
          <li>Focused website</li><li>Business-profile foundation</li><li>Clear enquiry path</li>
        </ul>
        <a class="signal-link signal-link--dark" href="/services#online-foundation">
          See the foundation
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </article>
      <p class="offer-ledger__choice">or</p>
      <article id="home-visibility">
        <div class="offer-ledger__title">
          <h2>Ongoing Visibility</h2>
          <span>$600–$1,800 typical · monthly</span>
        </div>
        <p>
          Optional support that keeps useful profiles and content active after the base is sound.
        </p>
        <ul><li>Content direction</li><li>Profile upkeep</li><li>Sustainable cadence</li></ul>
        <a class="signal-link" href="/services#ongoing-visibility">
          See ongoing support
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </article>
    </div>

    <div class="site-frame capability-path">
      <div class="capability-path__intro">
        <h3 id="capability-path-title">From first look to lasting presence.</h3>
        <p>
          This is one useful route to a stronger online presence. Start wherever the gap is; each
          service works on its own.
        </p>
      </div>
      <ol class="capability-path__steps" aria-labelledby="capability-path-title">
        {
          capabilities.map((capability, index) => (
            <li class="capability-path__step">
              <span class="capability-path__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="capability-path__copy">
                <h4>{capability.headline}</h4>
                <p class="capability-path__service">{capability.title}</p>
                <p>{capability.text}</p>
                <a class="signal-link signal-link--dark" href={`/services#${capability.id}`}>
                  Explore {capability.title}
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M4 10h11M11 5l5 5-5 5" />
                  </svg>
                </a>
              </div>
              <figure class="capability-path__media">
                <Image
                  src={capability.image}
                  alt={capability.imageAlt}
                  widths={[480, 720, 960, capability.image.width]}
                  sizes="(max-width: 58rem) calc(100vw - 6rem), 42vw"
                  format="webp"
                  quality={78}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </li>
          ))
        }
      </ol>
      <div class="capability-path__finish">
        <span>Start with the gap that matters now.</span>
        <a class="signal-link signal-link--dark" href="/services#service-guide">
          Find your starting point
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <section
    class="process-section chapter-stack chapter-stack--narrow chapter-stack--dark chapter-stack--foreground"
    aria-labelledby="process-title"
  >
    <div class="site-frame process-intro">
      <h2 id="process-title">From first conversation to something you can use.</h2>
      <div>
        <p>No mystery process. No pressure to buy every service at once.</p>
        <a class="signal-link" href="/how-we-work">
          Explore the full handoff
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </div>
    </div>
    <div class="site-frame"><ProcessRoute headingId="process-title" /></div>
  </section>

  <section
    class="founder-section chapter-stack chapter-stack--wide chapter-stack--slate"
    aria-labelledby="founder-title"
  >
    <div class="site-frame founder-layout">
      <EditorialPlate
        image={SITE.founderPortrait}
        alt="Saymon Rivas holding a laptop displaying the Azul Online Projects website."
        label="Founder-led in Orlando"
        caption="The same person shaping the strategy stays close to the build."
        code="Saymon / Azul"
        className="founder-photo-card founder-portrait-plate"
        compact
      />
      <div class="founder-copy">
        <h2 id="founder-title">Built at the useful intersection.</h2>
        <p class="founder-lead">
          I studied computer science at UCF and saw a practical gap: small businesses need solid
          digital systems, but they also need ideas that make people pay attention.
        </p>
        <p>
          Azul Online Projects brings those needs together. The goal is not to pile on tools. It is
          to create a presence that feels credible, works reliably, and gives the right people a
          reason to come closer.
        </p>
        <a class="signal-link" href="/about">
          Why Azul exists
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
      </div>
    </div>
  </section>
</RootLayout>

<script src="../scripts/capability-path.ts"></script>
<script src="../scripts/signal-field.ts"></script>
