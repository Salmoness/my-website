{
  "name": "my-website-monorepo",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.6.0 <25.0.0",
    "pnpm": ">=11.25.0 <12.0.0"
  },
  "scripts": {
    "dev:site": "pnpm --filter site dev",
    "build": "npm --prefix apps/site run build && node scripts/copy-dist.mjs",
    "typecheck": "pnpm --filter site typecheck",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "pnpm --filter site test",
    "test:e2e": "pnpm --filter site test:e2e"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript-eslint": "8.69.0"
  }
}
